{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://cdn.discordapp.com; media-src 'self'; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"},
        {"key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"},
        {"key": "X-Permitted-Cross-Domain-Policies", "value": "none"}
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/index.php",
      "destination": "/api/not-found.php"
    },
    {
      "source": "/includes/:path*",
      "destination": "/api/not-found.php"
    },
    {
      "source": "/bot/:path*",
      "destination": "/api/not-found.php"
    },
    {
      "source": "/scripts/:path*",
      "destination": "/api/not-found.php"
    }
  ]
}
