DISCORD_CLIENT_ID=1479835689284669461
# Optional: Client-ID der Bot-Anwendung, die in den Servern installiert wird.
# Wenn der Ziel-Bot eine eigene Discord-Anwendung hat, hier deren Client-ID eintragen.
DISCORD_BOT_CLIENT_ID=
# Discord Bot-Token: nur für ausgehende Discord-API-Abfragen der Website.
DASHBOARD_BOT_TOKEN=
DISCORD_CLIENT_SECRET=füge_hier_dein_client_secret_ein
# Separater, zufälliger Schlüssel für Bot ↔ Website Dashboard-Synchronisierung.
# Muss auf Website-Host und Bot-Host identisch sein; niemals Discord-Token verwenden.
# Bestehendes BOT_WEBHOOK_SECRET wird vorübergehend als Fallback akzeptiert.
DASHBOARD_BRIDGE_SECRET=
# Nur für andere Website-Funktionen, nicht für die Dashboard-Synchronisierung:
DISCORD_BOT_TOKEN=füge_hier_dein_bot_token_ein
# Gemeinsamer interner Schlüssel zwischen PHP-Website und Python-Bot.
# Das ist NICHT die URL eines Discord-Webhooks.
BOT_WEBHOOK_SECRET=ersetze_durch_ein_langes_zufaelliges_geheimnis
# Alte Bot-Ticket-Veröffentlichung ist deaktiviert; Tickets bleiben im Webportal.
BOT_INTERNAL_URL=
BOT_HTTP_HOST=127.0.0.1
BOT_HTTP_PORT=8765
# Nur auf dem externen Bot-Server: auf 0.0.0.0 setzen und TLS-Zertifikat konfigurieren.
BOT_TLS_CERTFILE=
BOT_TLS_KEYFILE=
BOT_TRUSTED_TLS_PROXY=0
PUBLIC_SITE_URL=https://ironshield.novium.link
# Lokal: http://localhost:8000/?route=callback
# Veröffentlichung: exakt die öffentliche HTTPS-URL eintragen und in Discord OAuth2 → Redirects registrieren.
DISCORD_REDIRECT_URI=http://localhost:8000/?route=callback
TEAM_ADMIN_USERNAME=ownerironshield
TEAM_ADMIN_PASSWORD=bitte-ein-eigenes-langes-passwort-mit-mindestens-14-zeichen-setzen
# Teamkonten, Tickets und Ankündigungen landen auf Novium standardmäßig in /home/container/.ironshield-private/store.json.
# Bei einem anderen Hosting hier den absoluten Pfad eines persistenten Volumes konfigurieren; niemals /tmp verwenden:
# TEAM_DATA_DIR=/home/container/private/ironshield-team
